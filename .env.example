# Optional server-managed AI path. You can instead enter your own key in RouteHours Settings.
GEMINI_API_KEY=
# Required only if using the optional server-managed AI path.
APP_ACCESS_TOKEN=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional public OAuth client ID fallback. You can enter it in RouteHours Settings instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
