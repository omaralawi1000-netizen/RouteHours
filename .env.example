# Server only. Get a key from Google AI Studio.
GEMINI_API_KEY=
# Set a strong, private code before exposing the app online.
APP_ACCESS_TOKEN=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash
# Public OAuth client ID, for direct Google Sheet creation.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
